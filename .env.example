# -----------------------------------------------------------------------------
# lingplay environment
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. Never commit .env.local.

# Auth token used to sign JWT session cookies. Any long random string works;
# generate one with `openssl rand -hex 32`.
JWT_SECRET=

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------
# LingModel is the default. When LINGMODEL_AUTH_TOKEN is set, the app routes
# every AI call through the LingModel proxy (Anthropic-wire compatible).
# Falls back to direct Anthropic only when LingModel is unavailable.
LINGMODEL_AUTH_TOKEN=

# Optional overrides for LingModel (safe to leave blank — defaults are fine):
#   LINGMODEL_BASE_URL=https://lingcode.dev/api/inference/anthropic
#   LINGMODEL_MODEL=kimi-k2.7

# Only needed if you don't have a LINGMODEL_AUTH_TOKEN — direct Anthropic path.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# -----------------------------------------------------------------------------
# MySQL (see lib/mysql/server.ts for the exact connection string it reads)
# -----------------------------------------------------------------------------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=gameengine

# -----------------------------------------------------------------------------
# Optional: OpenAI Moderation API for the safety pipeline
# -----------------------------------------------------------------------------
# Without this key, moderation still runs but only uses the local keyword scan
# (lib/safety/keyword-scan.ts). The OpenAI Moderation endpoint gives nuanced
# category flagging on top of the local scan.
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Optional: Meshy AI for text-to-3D model generation
# -----------------------------------------------------------------------------
# Used by /api/ai/generate-character to synthesize a real 3D model from a
# prompt (via api.meshy.ai). Without this key the character selector's AI tab
# still works but falls back to a colored primitive.
# MESHY_API_KEY=msy_...

# --- Email (parental consent) -------------------------------------------
# Without RESEND_API_KEY the app does NOT silently skip consent: signup tells
# the child we couldn't send it and shows the link to hand to their parent.
RESEND_API_KEY=
EMAIL_FROM="lingplay <noreply@lingcode.dev>"
